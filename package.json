{
	"name": "pedalvision",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"test": "vitest run",
		"typecheck": "tsc -b",
		"lint": "biome ci",
		"e2e": "playwright test",
		"bench:capacity": "pnpm build && playwright test --config=playwright.benchmark.config.ts",
		"preview": "vite preview",
		"catalog:import": "node --experimental-strip-types tools/catalog-transform/index.ts import",
		"catalog:seed": "node --experimental-strip-types tools/catalog-transform/index.ts seed",
		"catalog:reclassify": "node --experimental-strip-types tools/catalog-transform/index.ts reclassify",
		"catalog:resolve-images": "node --experimental-strip-types tools/catalog-transform/index.ts resolve-images",
		"catalog:inventory": "node --experimental-strip-types tools/catalog-transform/index.ts inventory",
		"catalog:validate-seed": "node --experimental-strip-types tools/catalog-transform/index.ts validate-seed",
		"asset:process": "node --experimental-strip-types tools/asset-pipeline/index.ts",
		"catalog:build": "node --experimental-strip-types tools/catalog-pipeline/index.ts build",
		"catalog:validate": "node --experimental-strip-types tools/catalog-pipeline/index.ts validate",
		"catalog:check": "node --experimental-strip-types tools/catalog-pipeline/index.ts check",
		"catalog:check-jacks": "node --experimental-strip-types tools/catalog-pipeline/index.ts check-jacks",
		"catalog:demo-link": "node --experimental-strip-types tools/catalog-demo/index.ts",
		"catalog:ci": "node --experimental-strip-types tools/catalog-pipeline/index.ts ci",
		"catalog:post-merge": "node --experimental-strip-types tools/catalog-pipeline/index.ts post-merge",
		"catalog:guard-batch-pr": "node --experimental-strip-types tools/catalog-pipeline/index.ts guard-batch-pr",
		"catalog:dry-run": "node --experimental-strip-types tools/catalog-pipeline/index.ts dry-run",
		"catalog:start": "node --experimental-strip-types tools/catalog-runner/index.ts start",
		"catalog:status": "node --experimental-strip-types tools/catalog-runner/index.ts status",
		"catalog:pause": "node --experimental-strip-types tools/catalog-runner/index.ts pause",
		"catalog:stop": "node --experimental-strip-types tools/catalog-runner/index.ts stop",
		"catalog:resume": "node --experimental-strip-types tools/catalog-runner/index.ts resume",
		"catalog:checkpoint": "node --experimental-strip-types tools/catalog-runner/index.ts checkpoint",
		"catalog:heartbeat": "node --experimental-strip-types tools/catalog-runner/index.ts heartbeat",
		"catalog:finish": "node --experimental-strip-types tools/catalog-runner/index.ts finish",
		"catalog:flag": "node --experimental-strip-types tools/catalog-runner/index.ts flag",
		"catalog:runner": "node --experimental-strip-types tools/catalog-runner/index.ts",
		"catalog:wave": "node --experimental-strip-types tools/catalog-wave/index.ts",
