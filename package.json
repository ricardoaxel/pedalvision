		"@playwright/test": "^1.63.0",
		"@rolldown/binding-darwin-arm64": "^1.2.11",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"sharp": "0.35.5",
		"typescript": "~6.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.2"
	}
