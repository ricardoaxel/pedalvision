		"asset:board-color": "node --experimental-strip-types tools/asset-pipeline/board-color-cli.ts",
		"asset:board-art": "node --experimental-strip-types tools/asset-pipeline/board-art-cli.ts",
		"asset:contact-sheet": "node --experimental-strip-types tools/asset-pipeline/contact-sheet-cli.ts",
		"asset:qa": "node --experimental-strip-types tools/asset-pipeline/qa-cli.ts",
		"asset:psnr": "node --experimental-strip-types tools/asset-pipeline/psnr-cli.ts"
